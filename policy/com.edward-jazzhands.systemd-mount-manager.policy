<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Edward Jazzhands</vendor>
  <vendor_url>https://github.com/edward-jazzhands/systemd-mount-manager</vendor_url>

  <!-- Action for managing systemd mount units -->
  <action id="com.edward-jazzhands.systemd-mount-manager.manage-mounts">
    <description>Manage systemd mount units</description>
    <message>Authentication is required to manage system mount points</message>
    <icon_name>drive-harddisk</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/systemctl</annotate>
  </action>

  <!-- Action for writing mount unit files -->
  <action id="com.edward-jazzhands.systemd-mount-manager.write-config">
    <description>Write systemd mount configuration files</description>
    <message>Authentication is required to create or modify mount configurations</message>
    <icon_name>document-save</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/tee</annotate>
  </action>

</policyconfig>