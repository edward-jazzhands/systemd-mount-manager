# This removes the focus highlight from text on buttons
Button {
    background: $boost;
    min-width: 8;
    &:focus {
        text-style: none;
        background: $primary-darken-2;
        color: $text;
    }
    &:hover {
        background: $surface-lighten-2;
    }
}

# Mixins
.h1 { height: 1; }
.h2 { height: 2; }
.h3 { height: 3; }
.h4 { height: 4; }
.h5 { height: 5; }
.h6 { height: 6; }
.wauto { width: auto; }
.hauto { height: auto; }
.w1fr { width: 1fr; }
.h1fr { height: 1fr; }
.center-middle { align: center middle; }
.boost { background: $boost; }
.margin-1-0 { margin: 1 0; }
.margin-0-1 { margin: 0 1; }
.border-1 { border: outer $panel; }
.horizontal-scroll { overflow-x: auto; }

.compact-static {
    width: auto;
    padding: 0 1;
    # background: blue;
    content-align: center middle;
}

.inline-header {
    height: 2;
    content-align: left middle;
    border-bottom: heavy $panel;
}

CustomHeader {
    height: 3;
    background: $surface;
    # padding: 0 1;
    border-bottom: hkey $panel;
    box-sizing: border-box;
    margin: 0 0 1 0;
    #ascii_banner {
        min-width: 83;
        width: auto;
    }
    #header_info {
        # background: blue;
        align: right top;
        padding: 0 1;
        & > Static {
            width: auto;
        }
    }
}

TabbedContent {
    # border: outer green;
    height: 1fr;
    .content-container {
        padding: 0;
        # background: blue;
    }
}

.card-container {
    margin: 1 3;
    padding: 0 1;
    border: outer $panel;
    height: auto;
    background: $surface;
}

.big-placeholder {
    min-height: 10;
}

#managed-mounts-container {
    width: auto;
    height: auto;
    # border: solid red;
}

ManagedMountWidget {
    height: 3;
    margin: 1 0;
    background: $surface-lighten-1;
    border: hkey $panel-lighten-1;
    # border-left: outer red;
}

.mount-data-box {
    width: auto;
    padding: 0 1;
    # background: blue;
}

#mount-col-names {
    height: 1;
    margin: 1 0 0 0;
}

.setting-option {
    margin: 0 0 1 0;
    background: $boost;
    border-left: outer $panel-lighten-2;
    .setting-description { 
        width: auto;
        height: 3;
        content-align: left middle;
        padding: 0 1;
    }
    # setting-input { width: 1fr; }   
    # setting-switch { background: green; }
}

.option-box {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    # padding: 0 0 0 1;
    background: $boost;
    border-left: outer $panel-lighten-2;
    Static {
        width: 1fr;
        height: auto;
        min-height: 3;
        content-align: left middle;
        padding: 0 2;
    }
}

.help-container {
    width: 80%;
    max-height: 80%;
    min-width: 70;
    min-height: 20;
    margin: 0 0 1 0;
    padding: 0 1;
    border: outer $panel;
    background: $surface;
    TextArea {
        height: 2;
        # overflow-x: hidden;
        # background: $surface;
        # text-overflow: ellipsis;
        # border: solid red;
        # scrollbar-visibility: hidden;
    }
}

.no-mounts-found {
    width: 1fr;
    border: outer $surface-darken-1;
    margin: 1;
    content-align: center middle;
    height: 5;
    # background: $surface-lighten-2;
}

FstabsCard {
    Button { margin: 0 1; }
    TextArea {
        height: auto;
    }
}   

.save-cancel-buttons {
    height: 3;
    #save-button { margin: 0 1; }
}