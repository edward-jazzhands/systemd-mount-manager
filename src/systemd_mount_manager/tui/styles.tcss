.compact-static {
    width: auto;
    padding: 0 1;
}

Button {&:focus {text-style: none;}}

.h1 { height: 1; }
.h2 { height: 2; }
.h3 { height: 3; }
.h4 { height: 4; }
.h5 { height: 5; }
.h6 { height: 6; }
.hauto { height: auto; }

.center-middle {
    align: center middle;
}

CustomHeader {
    height: 3;
    background: $surface;
    # padding: 0 1;
    border-bottom: hkey $panel;
    box-sizing: border-box;
    margin: 0 0 1 0;
    #ascii_banner {
        min-width: 83;
        width: auto;
    }
    #header_info {
        # background: blue;
        align: right top;
        padding: 0 1;
        & > Static {
            width: auto;
        }
    }
}

TabbedContent {
    # border: outer green;
    height: 1fr;
    .content-container {
        padding: 0;
        # background: blue;
    }
}

.card-container {
    margin: 1 3;
    padding: 0 1;
    border: outer $panel;
    height: auto;
    background: $surface;
}

.big-placeholder {
    min-height: 10;
}

ManagedMount {
    height: 3;
    margin: 1 0;
    background: $surface-lighten-1;
    border: hkey $panel-lighten-1;
    # border-left: outer red;
}

.mount-data-box {
    width: 1fr;
    padding: 0 1;
    # background: blue;
}

#mount-col-names {
    height: 1;
    margin: 1 0 0 0;
}

SettingOption {
    height: 6;
    width: 1fr;
    margin: 0 0 1 0;
    # padding: 0 0 0 1;
    background: $background-lighten-1;
    border-left: outer $panel-lighten-2;
    .setting-description { 
        width: auto;
        height: 3;
        content-align: left middle;
        padding: 0 2;
    }
    #setting-input { width: 1fr; }   
    # setting-switch { background: green; }
}

#help-container {
    width: 80%;
    height: 80%;
    min-width: 70;
    min-height: 20;
    margin: 0 0 1 0;
    padding: 0 1;
    border: outer $panel;
    background: $surface;
}

FstabsCard {
    TextArea {
        height: auto;
    }
}   

.save-cancel-buttons {
    height: 3;
    #save-button { margin: 0 1; }
}